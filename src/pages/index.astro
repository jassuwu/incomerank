---
import Layout from "../layouts/Layout.astro";
import countries from "../data/countries.index.json";
import type { CountryIndexEntry } from "../lib/types";

const list = countries as CountryIndexEntry[];
---

<Layout>
  <main class="mx-auto flex min-h-dvh w-full max-w-xl flex-col px-6 py-7">
    <div class="flex items-center justify-between border-b border-line pb-3">
      <span class="eyebrow">Income Rank</span>
      <button id="sound" type="button" role="switch" aria-checked="true" aria-label="Sound" title="Sound on / off" class="snd-btn text-muted transition hover:text-ink">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M11 5 6 9H3v6h3l5 4z" />
          <g class="snd-on"><path d="M15.5 8.5a5 5 0 0 1 0 7" /><path d="M19 5a9 9 0 0 1 0 14" /></g>
          <g class="snd-off"><line x1="16" y1="9" x2="22" y2="15" /><line x1="22" y1="9" x2="16" y2="15" /></g>
        </svg>
      </button>
    </div>

    <div class="stage flex flex-1 flex-col justify-center py-6">
      <!-- ── Input ─────────────────────────────────────────────────────── -->
      <form id="calc" class="reveal-stage" novalidate>
        <h1 class="display text-5xl leading-[0.95] sm:text-6xl">
          how much<br />do you make?
        </h1>

        <div class="mt-10 flex items-baseline gap-3 border-b-2 border-ink pb-2 focus-within:border-accent">
          <span id="cur" class="display text-3xl text-muted">$</span>
          <input
            id="amount"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            autofocus
            placeholder="72,000"
            class="display tabular w-full bg-transparent text-4xl outline-none placeholder:text-faint"
          />
          <select id="period" class="shrink-0 cursor-pointer bg-transparent text-sm text-muted outline-none hover:text-ink">
            <option value="annual">per year</option>
            <option value="monthly">per month</option>
          </select>
        </div>

        <label class="mt-5 flex items-center gap-2 text-sm text-muted">
          <span class="text-accent">◍</span>
          <select id="country" class="cursor-pointer bg-transparent text-ink outline-none">
            {list.map((c) => (
              <option value={c.iso} data-iso2={c.iso2} data-currency={c.currency} data-period={c.period}>
                {c.name}
              </option>
            ))}
          </select>
        </label>

        <button
          type="submit"
          class="mt-9 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 font-medium text-paper transition hover:bg-accent active:scale-[0.99]"
        >
          find my rank <span aria-hidden="true">→</span>
        </button>
        <p id="err" class="mt-3 h-4 text-sm text-accent-ink" role="alert" aria-live="polite"></p>
      </form>

      <!-- ── Reveal: ASCENT — the elevator with no top floor ───────────── -->
      <section id="reveal" class="hidden" aria-live="polite">
        <p id="reveal-eyebrow" class="eyebrow">Before the doors open…</p>
        <h2 class="hero-h display text-6xl leading-none sm:text-7xl">
          <span id="hero-line">guess your floor</span>
        </h2>

        <!-- the shaft + the car you ride in -->
        <div id="ascent" class="ascent relative mx-auto mt-6 select-none">
          <div id="field" class="shaft"></div>

          <!-- the car: your eye-line, fixed over the shaft (ride + explore) -->
          <div id="car" class="car">
            <span class="car-dot"></span>
            <div id="odo" class="odo"><b id="odo-num">…</b><span id="odo-lab"> people below you</span></div>
          </div>

          <!-- the draggable guess handle (guess phase) -->
          <div
            id="guess-puck"
            class="guess-puck"
            role="slider"
            tabindex="0"
            aria-label="guess how high you rank, drag up or down"
            aria-valuemin="1"
            aria-valuemax="99"
            aria-valuenow="50"
            aria-valuetext="global top 50%"
          >
            <span class="puck-line"></span>
            <span class="puck-dot"></span>
            <span class="puck-lab"><span class="puck-chev">↕</span> me? <b id="guess-lab">top 50%</b></span>
          </div>

          <!-- the lure to climb into the famous tail: an accent glow + a rising
               arrow + a prominent pill, so the "keep going" beat can't be missed -->
          <div id="continue-up" class="continue-up hidden">
            <div class="cu-glow" aria-hidden="true"></div>
            <div class="cu-chevrons" aria-hidden="true">
              <svg viewBox="0 0 24 10" width="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8 12 2l9 6" /></svg>
              <svg viewBox="0 0 24 10" width="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8 12 2l9 6" /></svg>
              <svg viewBox="0 0 24 10" width="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8 12 2l9 6" /></svg>
            </div>
            <button id="continue-up-btn" class="cu-btn" type="button">
              <span class="cu-arrow" aria-hidden="true">↑</span> keep going — who's up top?
            </button>
          </div>
        </div>

        <!-- guess prompt -->
        <div id="guess-ui" class="mt-4 max-w-sm mx-auto text-center">
          <p id="guess-instr" class="text-sm leading-snug text-muted">
            drag yourself <strong class="text-ink">up the tower</strong>. how high do you reckon you land?
          </p>
          <button id="guess-go" class="mt-3 inline-flex rounded-full bg-ink px-6 py-2.5 font-medium text-paper transition hover:bg-accent active:scale-[0.99]" type="button">
            lock it in →
          </button>
        </div>

        <!-- the gap detonation (post-ride) -->
        <p id="gap" class="rline mt-5 max-w-sm mx-auto hidden text-center text-sm"></p>

        <!-- explore (post-ride) -->
        <div id="explore" class="rline mt-5 max-w-sm mx-auto hidden">
          <input id="slider" type="range" min="0" max="1000" value="500" class="w-full cursor-pointer accent-accent" aria-label="Explore other incomes" />
          <p class="mt-1 text-center text-xs text-muted">
            drag to play with it. at <span id="slider-amt" class="text-ink">…</span> you'd be <span id="slider-top" class="text-ink">…</span>
          </p>
        </div>

        <blockquote id="persp" class="rline display mt-8 max-w-lg border-l-2 border-accent pl-4 text-2xl leading-snug text-ink-soft"></blockquote>
        <ul id="persp-list" class="rline mt-6 max-w-lg list-disc space-y-2 pl-5 text-[0.95rem] leading-relaxed text-muted marker:text-accent"></ul>

        <div id="where" class="rline mt-9 max-w-lg">
          <p class="eyebrow">Where you'd be rich</p>
          <ul id="where-list" class="mt-3 divide-y divide-line text-sm"></ul>
          <p id="where-mode-note" class="mt-2 text-xs text-faint"></p>
          <p id="where-note" class="mt-2 text-xs text-muted"></p>
        </div>

        <details id="method" class="rline mt-9 max-w-lg border-t border-line pt-5 text-sm">
          <summary class="method-summary eyebrow flex cursor-pointer list-none items-center gap-1.5 hover:text-accent">Sources &amp; method <span class="method-chev" aria-hidden="true">▾</span></summary>
          <p class="mt-3 leading-relaxed text-muted">
            the numbers aren't mine. i convert your <strong class="text-ink">gross</strong> income to
            <strong class="text-ink">US dollars at market exchange rates</strong> and rank it against
            everyone's, using the World Bank's income data (~7.9 billion people). heads up: i count
            you as a household of one and most countries report after-tax income, so your rank's
            probably a little <strong class="text-ink">flattering</strong>. it counts everyone alive,
            kids included. an estimate, not an exact salary rank.
          </p>
          <dl class="mt-4 space-y-2">
            <div class="flex justify-between gap-4 border-b border-line/60 pb-2">
              <dt class="text-muted">Source</dt>
              <dd class="text-right text-ink-soft">World Bank PIP, at market FX</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-line/60 pb-2">
              <dt class="text-muted">Underlying data</dt>
              <dd class="text-right text-ink-soft">cross-checked vs OWID &amp; GWWC</dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-line/60 pb-2">
              <dt class="text-muted">Extreme top tail (&gt; top 1%)</dt>
              <dd id="tail-note" class="text-right text-ink-soft">shaped to <a href="https://wid.world/" target="_blank" rel="noopener" class="text-accent hover:underline">WID.world</a> top incomes</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted">Famous names (the climb)</dt>
              <dd class="text-right text-ink-soft">Forbes earnings &amp; wealth growth · est.</dd>
            </div>
          </dl>
          <p class="mt-3 leading-relaxed text-muted">
            the famous folks up top are just a fun yardstick. for the creator/athlete/entertainer
            it's their yearly <strong class="text-ink">earnings</strong> ÷ 365. for the billionaires
            it's how much their net worth grew in a year ÷ 365 (paper gains, not a paycheck...
            swings hard, sometimes negative). rough ballparks, not pay stubs.
          </p>
          <p class="mt-4 text-xs text-muted">
            check it yourself:
            <a href="https://datacatalog.worldbank.org/search/dataset/0063646" target="_blank" rel="noopener" class="text-accent hover:underline">World Bank PIP</a> ·
            <a href="https://ourworldindata.org/grapher/daily-median-income" target="_blank" rel="noopener" class="text-accent hover:underline">Our World in Data</a> ·
            <a href="https://www.givingwhatwecan.org/how-rich-am-i-methodology" target="_blank" rel="noopener" class="text-accent hover:underline">Giving What We Can</a> ·
            <a href="https://www.forbes.com/real-time-billionaires/" target="_blank" rel="noopener" class="text-accent hover:underline">Forbes</a>
          </p>
        </details>

        <div class="rline mt-9 flex gap-3">
          <button id="share" class="rounded-full bg-ink px-6 py-3 font-medium text-paper transition hover:bg-accent">
            share my card
          </button>
          <button id="again" class="rounded-full border border-line px-6 py-3 font-medium text-muted transition hover:text-ink">
            again
          </button>
        </div>

        <!-- share-card preview (built on demand) -->
        <div id="share-panel" class="rline mt-5 hidden max-w-sm">
          <img id="share-img" alt="Your Income Rank card" class="mx-auto block w-full max-w-[20rem] rounded-xl border border-line shadow-sm" />
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <button id="share-send" class="rounded-full bg-accent px-5 py-2.5 font-medium text-paper transition hover:bg-ink">share</button>
            <button id="share-save" class="rounded-full border border-line px-5 py-2.5 font-medium text-muted transition hover:text-ink">save image</button>
            <button id="share-copy" class="rounded-full border border-line px-5 py-2.5 font-medium text-muted transition hover:text-ink">copy link</button>
          </div>
          <p class="mt-2 text-xs text-faint">your income's not on the card or the link. just your rank.</p>
        </div>
      </section>
    </div>

    <footer class="mt-8 flex items-center justify-between border-t border-line pt-4">
      <span class="eyebrow">
        made by <a href="https://jass.gg" target="_blank" rel="noopener" class="text-ink-soft transition hover:text-accent">jass</a>
      </span>
      <a
        href="https://github.com/jassuwu/incomerank"
        target="_blank"
        rel="noopener"
        class="eyebrow flex items-center gap-1.5 transition hover:text-accent"
        aria-label="Source on GitHub"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        source
      </a>
    </footer>
  </main>

  <script>
    import "../scripts/calculator.ts";
  </script>
</Layout>

<style>
  .reveal-stage {
    transition: opacity 0.32s ease, transform 0.32s ease;
  }
  .rline {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  #reveal.show .rline {
    opacity: 1;
    transform: none;
  }

  /* The rotating pull-quote fades when it swaps. */
  #persp {
    transition: opacity 0.2s ease;
  }
  #persp.fade {
    opacity: 0;
  }

  /* ASCENT — the elevator with no top floor. Income is altitude; you ride a
     glass car up the shaft past everyone on earth, the world scrolls past, the
     camera is a pure vertical pan (SVG viewBox) so type stays crisp at every floor. */
  /* the shaft is sized by HEIGHT (viewport-aware) so the whole reveal always fits;
     width follows the aspect. keeps the puck math exact (no letterboxing). */
  .ascent {
    touch-action: none;
    position: relative;
    margin-inline: auto;
    height: min(52dvh, 116vw, 460px);
    aspect-ratio: 232 / 300; /* VIEW_W / VIEW_H from tower.ts */
    max-width: 100%;
  }
  .shaft {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-left: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
  }
  /* :global(svg) — the shaft svg is injected via innerHTML at runtime, so it has no
     astro-cid scope attr; a plain `.shaft svg` rule would never match it (it was
     falling back to the browser default: width 100% but intrinsic-aspect height,
     ~2.6px shorter than the container and top-pinned). That mismatch is why the CSS
     car (54% of the container) never landed on a floor line (54% of the shorter svg).
     Force the svg to FILL the shaft in both axes; with preserveAspectRatio slice the
     viewBox then maps 1:1 onto container-y, so the car + puck + lines all agree. */
  .shaft :global(svg) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* guess phase: smaller prompt + tighter spacing so the shaft AND lock button
     are fully visible on one screen, every form factor. */
  #reveal.guessing .hero-h { font-size: clamp(1.5rem, 6vw, 2.25rem); line-height: 1.15; }
  /* the guess shaft frames a TALLER window (GUESS_VIEW_H=390 in tower.ts) so the puck
     reaches down to ~top 97%; same height footprint, just a proportionally narrower
     column. The aspect MUST match VIEW_W / GUESS_VIEW_H for the puck math to land. */
  #reveal.guessing .ascent { height: min(48dvh, 112vw, 420px); aspect-ratio: 232 / 390; margin-top: clamp(0.5rem, 2dvh, 1.25rem); }
  #reveal.guessing #guess-ui { margin-top: clamp(0.6rem, 2dvh, 1.1rem); }
  /* during the guess, the post-reveal content isn't in play — collapse it so the
     guess screen fits exactly with nothing to scroll into. */
  #reveal.guessing .rline { display: none; }
  /* short / landscape viewports: shrink everything (incl. page padding) so the
     whole guess screen still fits with no scroll. */
  @media (max-height: 600px) {
    main { padding-block: 0.4rem !important; }
    .stage { padding-block: 0.3rem !important; }
    #reveal.guessing .hero-h { font-size: 1.1rem; }
    #reveal.guessing .ascent { height: min(44dvh, 112vw, 250px); margin-top: 0.3rem; }
    #reveal.guessing #guess-ui { margin-top: 0.4rem; }
    #reveal.guessing #guess-instr { font-size: 0.74rem; line-height: 1.2; }
    #reveal.guessing #guess-go { padding-top: 0.45rem; padding-bottom: 0.45rem; }
  }
  /* the car: your fixed eye-line at CAR_FRAC (54%) down the shaft */
  .car {
    position: absolute;
    left: 0;
    right: 0;
    top: 54%;
    pointer-events: none;
    z-index: 2;
  }
  .car::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -1px; /* center the 2px bar on the eye-line (the dot center) → lands on the floor line */
    height: 2px;
    background: var(--color-accent);
    opacity: 0.92;
  }
  .car-dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 15px;
    height: 15px;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .ascent.riding .car-dot { animation: youpulse 1.4s ease-in-out infinite; }
  @keyframes youpulse {
    0%, 100% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 22%, transparent); }
    50% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--color-accent) 8%, transparent); }
  }
  /* the doors-open beat: the car lands with a flash */
  .ascent.arrived .car-dot { animation: arrive 0.75s cubic-bezier(0.2, 0.9, 0.2, 1); }
  .ascent.arrived .car::before { animation: carline 0.75s ease-out; }
  @keyframes arrive {
    0% { transform: translate(-50%, -50%) scale(2.6); box-shadow: 0 0 0 22px color-mix(in srgb, var(--color-accent) 30%, transparent); }
    100% { transform: translate(-50%, -50%) scale(1); box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 22%, transparent); }
  }
  @keyframes carline {
    0% { opacity: 0.2; transform: scaleX(0.2); }
    60% { opacity: 1; }
    100% { opacity: 0.92; transform: scaleX(1); }
  }
  .odo {
    position: absolute;
    left: 8px;
    top: 11px;
    font-size: 0.72rem;
    line-height: 1.1;
    color: var(--color-muted);
    text-shadow: 0 0 6px var(--color-paper), 0 0 6px var(--color-paper);
  }
  .odo b { color: var(--color-ink); font-variant-numeric: tabular-nums; font-weight: 700; }
  /* "keep going" lure — the climb into the famous tail is the best part, so make
     it unmissable: an accent glow fading up the shaft, a rising arrow rail, and a
     bold pill. The wrapper is click-through; only the button takes the pointer. */
  .continue-up {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 3;
    pointer-events: none;
  }
  .continue-up:not(.hidden) {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* the accent "there's more up there" glow — a faded blur + linear accent wash
     pinned to the top of the shaft (the Mojify-style progressive blur, simplified) */
  .cu-glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 96px;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-accent) 30%, transparent),
      color-mix(in srgb, var(--color-accent) 12%, transparent) 42%,
      transparent
    );
    -webkit-mask-image: linear-gradient(to bottom, #000, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000, #000 35%, transparent);
    backdrop-filter: blur(2.5px);
    -webkit-backdrop-filter: blur(2.5px);
  }
  /* three chevrons climbing upward — the eye follows them into the tail */
  .cu-chevrons {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    margin-top: 8px;
    color: var(--color-accent);
    pointer-events: none;
  }
  .cu-chevrons svg { display: block; }
  .cu-chevrons svg:nth-child(1) { animation: cu-rise 1.4s ease-in-out infinite; }
  .cu-chevrons svg:nth-child(2) { animation: cu-rise 1.4s ease-in-out 0.16s infinite; opacity: 0.62; }
  .cu-chevrons svg:nth-child(3) { animation: cu-rise 1.4s ease-in-out 0.32s infinite; opacity: 0.34; }
  @keyframes cu-rise {
    0% { transform: translateY(4px); opacity: 0.2; }
    50% { opacity: 1; }
    100% { transform: translateY(-5px); opacity: 0.2; }
  }
  .cu-btn {
    pointer-events: auto;
    position: relative;
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    border: none;
    border-radius: 9999px;
    background: var(--color-accent);
    padding: 0.5rem 1.15rem;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-paper);
    cursor: pointer;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-accent) 32%, transparent);
    animation: cu-pulse 1.9s ease-in-out infinite;
    transition: background 0.2s ease, transform 0.12s ease;
  }
  .cu-btn:hover { background: var(--color-accent-ink); }
  .cu-btn:active { transform: scale(0.97); }
  .cu-arrow {
    font-weight: 900;
    animation: cu-bob 1.1s ease-in-out infinite;
  }
  @keyframes cu-pulse {
    0%, 100% { box-shadow: 0 6px 18px color-mix(in srgb, var(--color-accent) 26%, transparent); }
    50% { box-shadow: 0 9px 28px color-mix(in srgb, var(--color-accent) 48%, transparent); }
  }
  @keyframes cu-bob {
    0%, 100% { transform: translateY(1.5px); }
    50% { transform: translateY(-2px); }
  }

  /* the guess handle — a vertical slider you drag up the tower (up = richer) */
  .guess-puck {
    position: absolute;
    left: 0;
    right: 0;
    height: 44px; /* generous thumb target */
    transform: translateY(-50%);
    z-index: 4;
    cursor: grab;
    touch-action: none;
  }
  .guess-puck:active { cursor: grabbing; }
  .guess-puck:focus-visible { outline: none; }
  .guess-puck:focus-visible .puck-dot { box-shadow: 0 0 0 4px var(--color-paper), 0 0 0 7px var(--color-accent); }
  .puck-line {
    position: absolute;
    left: 0; right: 0; top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--color-accent);
    opacity: 0.55;
  }
  .puck-dot {
    position: absolute;
    left: 50%; top: 50%;
    width: 18px; height: 18px;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .puck-lab {
    position: absolute;
